#!/bin/sh
# Runs the iPad second screen in the foreground: the virtual monitor appears
# when the Connector app connects and disappears after it disconnects.
# Size/sharpness/orientation are chosen in the app (three-finger tap).
DIR=$(cd "$(dirname "$0")/.." && pwd)
. "$DIR/scripts/connector-config"
exec "$DIR/host/connector-host" --manage-display ${CONNECTOR_OUTPUT:+-o "$CONNECTOR_OUTPUT"} "$@"
